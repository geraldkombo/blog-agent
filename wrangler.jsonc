{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "blog-agent",
  "main": "deploy/cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "LLM_PROVIDER": "gmi",
    "LLM_MODEL": "Qwen/Qwen3.8-Flash",
    "PUBLISHERS": "buttondown,telegraph,writeas",
    "PUBLISH_MODE": "draft",
    "WORDS": "900"
  },
  "triggers": {
    "crons": ["30 5 * * *"]
  }
}
