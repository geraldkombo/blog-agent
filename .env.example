# ---- LLM providers (set one or more; LLM_PROVIDER picks the default) ----
LLM_PROVIDER=gemini          # gemini|groq|cerebras|openrouter|mistral|together|github|ollama|openai-compat|gmi
LLM_MODEL=gemini-2.0-flash

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GITHUB_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
# openai-compat (covers GMI Cloud, vLLM, LiteLLM, any OpenAI-shaped endpoint)
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_BASE=https://api.gmi-serving.com/v1
OPENAI_COMPAT_MODEL=Qwen/Qwen3.8-Max

# ---- Pipeline behaviour ----
BLOG_TOPIC=                  # topic for the next article (or use topics.txt rotation)
PUBLISHERS=buttondown        # comma list: beehiiv,buttondown,devto,hashnode,ghost,wordpress,writeas,telegraph,blogger,medium,github
PUBLISH_MODE=draft           # draft|publish
WORDS=900

# ---- Publishers ----
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_7e155d01-3f4b-466d-b6c8-31489751c62e
BUTTONDOWN_API_KEY=
DEVTO_API_KEY=
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=
GHOST_ADMIN_KEY=             # format id:secret  (Admin API key)
GHOST_URL=
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WRITEAS_POST_ID=             # optional: id of a post to update (with WRITEAS_SECRET); blank = new anonymous post
WRITEAS_SECRET=
BLOGGER_BLOG_ID=
GOOGLE_OAUTH_TOKEN=          # access token with blogger scope (see README)
MEDIUM_INTEGRATION_TOKEN=
MEDIUM_AUTHOR_ID=
# github publisher: uses git in the repo working dir (deploy-local) or GITHUB_TOKEN on Actions
GITHUB_REPO=                 # owner/repo for the static blog
GITHUB_BRANCH=main
